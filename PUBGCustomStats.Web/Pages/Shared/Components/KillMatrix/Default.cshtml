@model PUBGCustomStats.Web.Pages.Shared.Components.KillMatrix.KillMatrixViewModel

<style>
    .kill-matrix .kill-count { text-align: right; }
    .kill-matrix .victim-header {
        padding: 0.25rem 0.15rem;
        height: 160px;
        vertical-align: bottom;
        text-align: center;
        white-space: normal;
    }
    .kill-matrix .victim-header > .rotated {
        writing-mode: vertical-rl;
        transform: rotate(180deg);
        display: inline-block;
        white-space: nowrap;
        line-height: 1;
        padding: 0 0.25rem;
    }
    .kill-matrix .corner-header {
        min-width: 200px;
        height: 160px;
        padding: 0.25rem 0.35rem;
        text-align: center;
        vertical-align: bottom;
        position: relative;
        background-color: transparent;
    }
    .kill-matrix .corner-header::before {
        content: "";
        position: absolute;
        inset: 0;
        pointer-events: none;
        background: linear-gradient(to bottom left, transparent 49.6%, rgba(222, 226, 230, 0.95) 49.6%, rgba(222, 226, 230, 0.95) 50.4%, transparent 50.4%);
        z-index: 0;
    }
    .kill-matrix .corner-player {
        display: block;
        position: absolute;
        left: 50%;
        bottom: 0.25rem;
        transform: translateX(-50%);
        font-weight: 600;
        white-space: nowrap;
        line-height: 1.2;
        z-index: 1;
    }
    .kill-matrix .corner-victim {
        position: absolute;
        top: 0.25rem;
        right: 0.25rem;
        bottom: 1.7rem;
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1;
    }
    .kill-matrix .corner-victim > span {
        writing-mode: vertical-rl;
        transform: rotate(180deg);
        display: inline-block;
        white-space: nowrap;
        line-height: 1;
    }
    .kill-matrix table th, .kill-matrix table td { vertical-align: middle; }
    .kill-matrix td.suicide-cell { background-color: #343a40 !important; color: #fff !important; }
    .kill-matrix td.suicide-cell a { color: #fff !important; }
    .kill-matrix td.bluezone-cell { background-color: #0d6efd !important; color: #fff !important; }
    .kill-matrix td.bluezone-cell a { color: #fff !important; }
    .kill-matrix .hover-row td, .kill-matrix .hover-col { background-color: #e6f7ff !important; }
</style>

<div class="table-responsive kill-matrix">
    <table class="table table-sm table-bordered table-hover">
        <thead>
            <tr>
                <th class="corner-header">
                    <span class="corner-player">Player</span>
                    <span class="corner-victim"><span>Victim</span></span>
                </th>
                @foreach (var victim in Model.Victims)
                {
                    <th class="victim-header"><div class="rotated">@victim</div></th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var player in Model.Players)
            {
                var playerName = player.PlayerName ?? string.Empty;
                var isBlueZoneRow = string.Equals(playerName, "Blue Zone", StringComparison.OrdinalIgnoreCase);
                var isNonPlayerLink = string.Equals(playerName, "BOT", StringComparison.OrdinalIgnoreCase)
                    || isBlueZoneRow;
                <tr>
                    <td class="text-nowrap">
                        @if (isNonPlayerLink)
                        {
                            var routeName = isBlueZoneRow ? "BlueZone" : playerName;
                            <a asp-page="/NonPlayer" asp-route-name="@routeName">@player.PlayerName</a>
                        }
                        else
                        {
                            <a asp-page="/Player" asp-route-playerGuid="@player.PlayerGuid">@player.PlayerName</a>
                        }
                    </td>
                    @foreach (var victim in Model.Victims)
                    {
                        var value = Model.Counts.TryGetValue(player.PlayerGuid, out var row)
                            && row.TryGetValue(victim, out var count) ? count : 0;
                        var cellClasses = "text-end kill-count";
                        if (isBlueZoneRow) cellClasses += " bluezone-cell";
                        if (Model.SuicideCells.Contains($"{player.PlayerGuid}:{victim}")) cellClasses += " suicide-cell";
                        <td class="@cellClasses">@value</td>
                    }
                </tr>
            }
        </tbody>
    </table>
</div>

<script>
    (function () {
        document.querySelectorAll('.kill-matrix table').forEach(function (table) {
            table.querySelectorAll('thead th, tbody td').forEach(function (cell) {
                cell.addEventListener('mouseenter', function () {
                    const index = this.cellIndex;
                    table.querySelectorAll('tr').forEach(function (row) {
                        if (row.cells[index]) row.cells[index].classList.add('hover-col');
                    });
                    if (this.tagName === 'TD') this.parentElement.classList.add('hover-row');
                });
                cell.addEventListener('mouseleave', function () {
                    const index = this.cellIndex;
                    table.querySelectorAll('tr').forEach(function (row) {
                        if (row.cells[index]) row.cells[index].classList.remove('hover-col');
                    });
                    if (this.tagName === 'TD') this.parentElement.classList.remove('hover-row');
                });
            });
        });
    })();
</script>
