@model PUBGCustomStats.Web.Pages.Shared.Components.MatchScores.MatchScoresViewModel

@foreach (var match in Model.Matches)
{
    var rowClass = match.Match.DoNotCount == true ? "italic-row" : string.Empty;

    <h1>
        @match.Match.MatchNameOrDefault() (@match.Match.Map, @match.Match.GameMode)
        <small class="text-muted">[<a href="/match?matchGuid=@match.Match.MatchGuid">Match Log</a>]</small>
    </h1>
    <table class="table table-hover" data-toggle="table" data-sortable="true">
        <thead class="table-light">
            <tr class="@rowClass">
                <th>Player</th>
                <th class="text-end" data-sortable="true">Position</th>
                <th class="text-end">Kills <span class="d-none d-md-inline">(Headshots)</span></th>
                <th class="text-end d-none d-md-table-cell">Assists</th>
                <th class="text-end d-none d-md-table-cell">DBNOs</th>
                <th class="text-end">Damage <span class="d-none d-md-inline">(Place)</span></th>
                <th class="text-end d-none d-md-table-cell">Heals</th>
                <th class="text-end d-none d-md-table-cell">Boosts</th>
                <th class="text-end d-none d-md-table-cell">Revives</th>
                <th class="text-end">Death Type</th>
                <th class="text-end">Score</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in match.PlayerStats)
            {
                <tr class="@rowClass">
                    <td><a href="/Player/@row.PlayerGuid">@row.PlayerName</a></td>
                    <td class="text-end">
                        @if (row.Rank == 1)
                        {
                            <span title="First Place">🥇</span>
                        }
                        else if (row.Rank == 2)
                        {
                            <span title="Second Place">🥈</span>
                        }
                        else if (row.Rank == 3)
                        {
                            <span title="Third Place">🥉</span>
                        }
                        else
                        {
                            @row.Rank <text>&nbsp;</text>
                        }
                    </td>
                    <td class="text-end">@row.Kills <span class="d-none d-md-inline">(@row.HeadshotKills)</span></td>
                    <td class="text-end d-none d-md-table-cell">@row.Assists</td>
                    <td class="text-end d-none d-md-table-cell">@row.DBNOs</td>
                    <td class="text-end">
                        @row.DamageDealt.GetValueOrDefault(0).ToString("N2")
                        @if (row.DamagePlace.HasValue)
                        {
                            <text> (</text>
                            @if (row.DamagePlaceEqual.GetValueOrDefault())
                            {
                                <text>=</text>
                            }
                            @row.DamagePlace<text>)</text>
                        }
                        else
                        {
                            <text> (-) </text>
                        }
                    </td>
                    <td class="text-end d-none d-md-table-cell">@row.Heals</td>
                    <td class="text-end d-none d-md-table-cell">@row.Boosts</td>
                    <td class="text-end d-none d-md-table-cell">@row.Revives</td>
                    <td class="text-end">
                        @row.DeathType
                        @switch (row.DeathType)
                        {
                            case "alive":
                                <span>🟢</span>
                                break;
                            case "byzone":
                                <span>🔵</span>
                                break;
                            case "byplayer":
                                <span>☠️</span>
                                break;
                            case "suicide":
                                <span>💀</span>
                                break;
                            case "logout":
                                <span>🚪</span>
                                break;
                        }
                    </td>
                    <td class="text-end">@(match.Match.DoNotCount == true ? "N/A" : row.Score)</td>
                </tr>
            }
        </tbody>
    </table>
}
