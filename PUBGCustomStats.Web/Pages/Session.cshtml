@page
@model SessionModel
@{
    ViewData["Title"] = "Session " + Model.StartDate;
}

@if (!string.IsNullOrEmpty(Model.Name))
{
    <h1>@Model.Name</h1>
}

<ul class="nav nav-tabs mb-3" id="sessionTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" id="match-list-tab" data-bs-toggle="tab" data-bs-target="#match-list" type="button" role="tab" aria-controls="match-list" aria-selected="true">Match List</button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="match-scores-tab" data-bs-toggle="tab" data-bs-target="#match-scores" type="button" role="tab" aria-controls="match-scores" aria-selected="false">Match Scores</button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="kill-matrix-tab" data-bs-toggle="tab" data-bs-target="#kill-matrix" type="button" role="tab" aria-controls="kill-matrix" aria-selected="false">Kill Matrix</button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="knock-matrix-tab" data-bs-toggle="tab" data-bs-target="#knock-matrix" type="button" role="tab" aria-controls="knock-matrix" aria-selected="false">Knock Matrix</button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="damage-matrix-tab" data-bs-toggle="tab" data-bs-target="#damage-matrix" type="button" role="tab" aria-controls="damage-matrix" aria-selected="false">Damage Matrix</button>
    </li>
</ul>

<div class="tab-content" id="sessionTabContent">
    <div class="tab-pane fade show active" id="match-list" role="tabpanel" aria-labelledby="match-list-tab" tabindex="0">
        <table class="table table-hover">
            <thead class="table-light">
                <tr>
                    <th>Time</th>
                    <th>Name</th>
                    <th>Map</th>
                    <th>Type</th>
                    <th>View</th>
                    <th>Duration</th>
                    <th>Winner(s)</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var match in Model.Matches.OrderBy(m => m.MatchStartTime))
                {
                    var rowClass = match.DoNotCount ? "text-muted fst-italic" : string.Empty;
                    <tr class="@rowClass">
                        <td>
                            <span class="d-none d-sm-inline">@match.MatchStartTime?.ToLocalTime().ToShortDateString()</span>
                            @match.MatchStartTime?.ToLocalTime().ToLongTimeString()
                        </td>
                        <td><a href="/match?matchGuid=@match.MatchGuid">@match.MatchName</a></td>
                        <td>@match.Map</td>
                        <td>@match.GameMode</td>
                        <td>@match.Perspective</td>
                        <td>@match.MatchLength?.ToString("mm:ss")</td>
                        <td>@match.Winner</td>
                    </tr>
                }
            </tbody>
        </table>

        @if (Model.Table.Any())
        {
            @if (Model.Matches.Any(m => m.DoNotCount))
            {
                <p>Team Death Match, Hot Drop, Intense Battle Royal, and second run of the same game don't count towards overall stats.</p>
            }
            <table class="table table-hover" data-toggle="table" data-sortable="true">
                <thead class="table-light">
                    <tr>
                        <th>Player</th>
                        <th class="text-end" data-sortable="true">Matches</th>
                        <th class="text-end" data-sortable="true">Wins</th>
                        <th class="text-end">Kills <span class="d-none d-md-inline">(Headshots)</span></th>
                        <th class="text-end d-none d-md-table-cell">Assists</th>
                        <th class="text-end d-none d-md-table-cell">DBNOs</th>
                        <th class="text-end">Damage</th>
                        <th class="text-end d-none d-md-table-cell">Heals</th>
                        <th class="text-end d-none d-md-table-cell">Boosts</th>
                        <th class="text-end d-none d-md-table-cell">Revives</th>
                        <th class="text-end d-none d-md-table-cell">Play Zoned</th>
                        <th class="text-end d-none d-md-table-cell">Suicides</th>
                        <th class="text-end">Score</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Table.Values.OrderByDescending(s => s.Score).ThenByDescending(k => k.Kills))
                    {
                        <tr>
                            <td><a href="/Player/@row.PlayerGuid">@row.PlayerName</a></td>
                            <td class="text-end">@row.MatchesPlayed</td>
                            <td class="text-end">@row.Wins</td>
                            <td class="text-end">@row.Kills <span class="d-none d-md-inline">(@row.HeadshotKills)</span></td>
                            <td class="text-end d-none d-md-table-cell">@row.Assists</td>
                            <td class="text-end d-none d-md-table-cell">@row.DBNOs</td>
                            <td class="text-end">@row.DamageDealt.ToString("N2")</td>
                            <td class="text-end d-none d-md-table-cell">@row.Heals</td>
                            <td class="text-end d-none d-md-table-cell">@row.Boosts</td>
                            <td class="text-end d-none d-md-table-cell">@row.Revives</td>
                            <td class="text-end d-none d-md-table-cell">@row.DeathByZone</td>
                            <td class="text-end d-none d-md-table-cell">@row.DeathBySuicide</td>
                            <td class="text-end">@row.Score</td>
                        </tr>
                    }
                </tbody>
            </table>
            <p>Scoring: 1 point for participation. 10 points for a win, 9 for second place and so on to 1 point for 10th place. 10 points for most damage, 9 points for second most damage, down to 1 point for 10th most damage. No damage points awarded, if no damage dealt.</p>
        }
        else
        {
            <p>Note: No matches from this session counted for overall totals.</p>
        }
    </div>

    <div class="tab-pane fade" id="match-scores" role="tabpanel" aria-labelledby="match-scores-tab" tabindex="0">
        @await Component.InvokeAsync("MatchScores", new { sessionGuid = Model.SessionGuid })
    </div>

    <div class="tab-pane fade" id="kill-matrix" role="tabpanel" aria-labelledby="kill-matrix-tab" tabindex="0">
        @if (Model.SessionGuid.HasValue)
        {
            @await Component.InvokeAsync("KillMatrix", new { sessionGuid = Model.SessionGuid.Value })
        }
    </div>

    <div class="tab-pane fade" id="knock-matrix" role="tabpanel" aria-labelledby="knock-matrix-tab" tabindex="0">
        @if (Model.SessionGuid.HasValue)
        {
            @await Component.InvokeAsync("KnockMatrix", new { sessionGuid = Model.SessionGuid.Value })
        }
    </div>

    <div class="tab-pane fade" id="damage-matrix" role="tabpanel" aria-labelledby="damage-matrix-tab" tabindex="0">
        @if (Model.SessionGuid.HasValue)
        {
            @await Component.InvokeAsync("DamageMatrix", new { sessionGuid = Model.SessionGuid.Value })
        }
    </div>
</div>
